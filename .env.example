# Copy this file to .env.local and fill in values as needed.

# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX).
# Leave unset to ship with no analytics — src/components/Analytics.tsx
# renders nothing until this is set.
NEXT_PUBLIC_GA_ID=

# Resend API key (https://resend.com) used by src/app/api/contact/route.ts
# to send contact form submissions. Leave unset and the form will show an
# honest "not configured yet" error instead of pretending to send.
RESEND_API_KEY=

# Where contact form submissions should be delivered. Falls back to
# org.contact.email in src/lib/data/site.ts if unset.
CONTACT_TO_EMAIL=

# Verified sending address for Resend (e.g. "ADESEN <contact@adesen.rw>").
# Until a domain is verified in Resend, leave unset to use their shared
# onboarding@resend.dev sandbox address.
CONTACT_FROM_EMAIL=
